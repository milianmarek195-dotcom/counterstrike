{
  "name": "@celtist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Celtist platform API: REST, Socket.IO, server gateway and background jobs",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "start:dev-mock": "nest build && node dist/dev-main.js"
  },
  "dependencies": {
    "@celtist/database": "*",
    "@celtist/shared": "*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.0",
    "cookie": "^2.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@celtist/mock-cs2-server": "*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ioredis-mock": "^8.13.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "vitest": "^4.1.2"
  }
}
