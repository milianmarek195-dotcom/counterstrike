{
  "name": "@celtist/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure domain logic, Zod schemas and types shared by api, web and tools",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "default": "./dist/signing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^4.1.2"
  }
}
