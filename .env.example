# Celtist Tournament Platform – environment template.
# Copy to .env (never commit .env). Every value below is validated at API start-up; the process
# refuses to boot with missing or weak secrets. Generate secrets with:  node scripts/generate-secrets.mjs

NODE_ENV=development
LOG_LEVEL=info

# ── Database / Redis ─────────────────────────────────────────────
DATABASE_URL=postgresql://celtist:CHANGE_ME@localhost:5432/celtist
REDIS_URL=redis://localhost:6379

# ── Public URLs ──────────────────────────────────────────────────
# Web (Next.js) and API must share a registrable domain so the session cookie works for both.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Cookie domain, e.g. .example.com in production; leave empty in development (host-only cookie).
COOKIE_DOMAIN=
# Comma separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
API_PORT=4000
# Set to the number of reverse proxies in front of the API (Caddy = 1) so client IPs are correct.
TRUST_PROXY=0

# ── Steam ────────────────────────────────────────────────────────
# Create a key at https://steamcommunity.com/dev/apikey (domain = your web domain)
STEAM_API_KEY=
STEAM_OPENID_URL=https://steamcommunity.com/openid
# Comma separated SteamID64s that get the Owner role when they log in (use this for the first admin).
# Find yours on https://steamid.io – it is the 17-digit number starting with 7656119.
OWNER_STEAM_IDS=

# ── Secrets (min. 32 characters each) ────────────────────────────
SESSION_SECRET=
# Master secret for deriving per-server HMAC keys (see docs/PLUGIN.md)
SERVER_API_SECRET=
# Base64 of exactly 32 random bytes; encrypts stored webhook URLs (AES-256-GCM)
ENCRYPTION_KEY=

# ── Optional integrations ────────────────────────────────────────
# Default Discord webhook for platform events. More can be added in the admin panel.
DISCORD_WEBHOOK=
# Skin price source: skinport | none
SKIN_PRICE_PROVIDER=skinport
SKIN_CATALOG_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/skins_not_grouped.json
STICKER_CATALOG_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/stickers.json

# ── Files ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Process roles ────────────────────────────────────────────────
# all = HTTP + WebSocket + background jobs | http = no jobs | worker = jobs only
APP_ROLE=all

# ── Backups (used by docker/backup container) ────────────────────
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4

# ── Production (docker-compose.prod.yml only) ────────────────────
CELTIST_DOMAIN=
CELTIST_API_DOMAIN=
POSTGRES_PASSWORD=
